{
  "openapi": "3.1.0",
  "info": {
    "title": "P05 — Proveedor simulado de tarifas",
    "version": "0.2.0",
    "description": "Fase 2: catálogo ficticio PROD-001 (19.90 EUR), PROD-002 (125.50 EUR) y PROD-003 (0.99 EUR). Precios de ejecución centralizados en proveedor/src/app.ts, en céntimos enteros. Sin base de datos ni reservas. Cuerpos limitados a 4096 bytes. No sirve archivos. Errores de infraestructura pueden contener HTML/texto."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3055",
      "description": "Solo loopback. HTTPS temporal se configura fuera del repositorio."
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Proceso disponible, sin configuración.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/tarifas/consultar": {
      "post": {
        "operationId": "consultarTarifa",
        "description": "Sin reintentos ni idempotencia: cada consulta correcta genera quoteId nuevo. UUID válido se conserva exactamente; si falta o es inválido se genera otro para el error. quantity no se convierte desde cadenas.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "productCode",
                  "quantity"
                ],
                "properties": {
                  "productCode": {
                    "type": "string",
                    "pattern": "^PROD-[0-9]{3}$"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              },
              "examples": {
                "PROD-001": {
                  "value": {
                    "productCode": "PROD-001",
                    "quantity": 3
                  }
                },
                "PROD-002": {
                  "value": {
                    "productCode": "PROD-002",
                    "quantity": 2
                  }
                },
                "PROD-003": {
                  "value": {
                    "productCode": "PROD-003",
                    "quantity": 7
                  }
                },
                "PROD-999": {
                  "value": {
                    "productCode": "PROD-999",
                    "quantity": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarifa emitida; sin persistencia Salesforce en fase 2.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarifa"
                },
                "examples": {
                  "PROD-001": {
                    "value": {
                      "schemaVersion": "1",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "quoteId": "22222222-2222-4222-8222-222222222222",
                      "productCode": "PROD-001",
                      "quantity": 3,
                      "currency": "EUR",
                      "unitPrice": "19.90",
                      "totalPrice": "59.70",
                      "issuedAt": "2026-11-19T12:00:00.000Z",
                      "validUntil": "2026-11-20T12:00:00.000Z",
                      "tariffVersion": "demo-1"
                    }
                  },
                  "PROD-002": {
                    "value": {
                      "schemaVersion": "1",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "quoteId": "22222222-2222-4222-8222-222222222222",
                      "productCode": "PROD-002",
                      "quantity": 2,
                      "currency": "EUR",
                      "unitPrice": "125.50",
                      "totalPrice": "251.00",
                      "issuedAt": "2026-11-19T12:00:00.000Z",
                      "validUntil": "2026-11-20T12:00:00.000Z",
                      "tariffVersion": "demo-1"
                    }
                  },
                  "PROD-003": {
                    "value": {
                      "schemaVersion": "1",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "quoteId": "22222222-2222-4222-8222-222222222222",
                      "productCode": "PROD-003",
                      "quantity": 7,
                      "currency": "EUR",
                      "unitPrice": "0.99",
                      "totalPrice": "6.93",
                      "issuedAt": "2026-11-19T12:00:00.000Z",
                      "validUntil": "2026-11-20T12:00:00.000Z",
                      "tariffVersion": "demo-1"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: cabecera, cuerpo, tipo o tamaño inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: clave ausente o incorrecta; autenticación antes de procesar el cuerpo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "PRODUCT_NOT_FOUND: código válido no presente en el catálogo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: puede devolverlo la infraestructura; no necesariamente JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: fallo inesperado, sin detalles internos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PROVIDER_UNAVAILABLE: infraestructura no disponible; no necesariamente JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "64 caracteres hexadecimales aleatorios, generados localmente y almacenados como secreto protegido."
      }
    },
    "schemas": {
      "Tarifa": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "requestId",
          "quoteId",
          "productCode",
          "quantity",
          "currency",
          "unitPrice",
          "totalPrice",
          "issuedAt",
          "validUntil",
          "tariffVersion"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1",
            "description": "Versión de contrato admitida: 1. No es la versión de tarifa."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "quoteId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "productCode": {
            "type": "string",
            "pattern": "^PROD-[0-9]{3}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "currency": {
            "type": "string",
            "const": "EUR"
          },
          "unitPrice": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})\\.[0-9]{2}$",
            "description": "Positivo, máximo 999999.99. El cliente valida límites y coherencia, sin incrustar precios del catálogo.",
            "not": {
              "const": "0.00"
            }
          },
          "totalPrice": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$",
            "description": "Precio unitario por cantidad; cálculo en céntimos enteros."
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "description": "issuedAt más exactamente 24 horas."
          },
          "tariffVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S",
            "description": "Identificador de tarifa de 1 a 64 caracteres, no compuesto solo por espacios. Independiente de schemaVersion. El proveedor emite demo-1; el cliente acepta otras versiones válidas."
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "error"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "UNAUTHORIZED",
                  "PRODUCT_NOT_FOUND",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "PROVIDER_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
